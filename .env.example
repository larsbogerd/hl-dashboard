# One URL + key per service. Full URLs, so services can live on
# different machines, ports or behind a reverse proxy.
#
# VITE_*_URL is readable by the browser — it's needed for the card links
# and isn't a secret. The API keys stay unprefixed so they never reach
# the bundle; only the Vite dev server (Node) sees them.
#
# Leave a service blank to skip it — its card just won't get a link.

VITE_SONARR_URL=http://192.168.1.118:8989
SONARR_API_KEY=

VITE_RADARR_URL=http://192.168.1.118:7878
RADARR_API_KEY=

VITE_PROWLARR_URL=http://192.168.1.118:9696
PROWLARR_API_KEY=

VITE_BAZARR_URL=http://192.168.1.118:6767
BAZARR_API_KEY=

VITE_QBITTORRENT_URL=http://192.168.1.118:8080
QBITTORRENT_API_KEY=

VITE_PLEX_URL=http://192.168.1.118:32400
PLEX_API_KEY=
